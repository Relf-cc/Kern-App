{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kern",
  "version": "0.2.5",
  "identifier": "app.kern.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run app:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kern",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost wss://api.relf.cloud ws://localhost:8787 ws://127.0.0.1:8787; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/kern-mcp"
    ],
    "resources": [
      "binaries/kern.mcpb"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first personal productivity workspace",
    "longDescription": "Kern brings tasks, projects, Kanban boards, whiteboards, notes, a daily rundown and a focus timer together in one calm desktop app. Everything stays on your computer unless you choose Kern Cloud to sync your own space or collaborate in workspaces.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kern"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMzYzMTVFMkRCQ0IyMTIKUldRU3Nyd3RYakUybzAwRjRxUS91eUZ0ZGRpUDBTQVFSQ1NDbkpvZEkwNnA4UUN3REpGVUVQWEkK",
      "endpoints": [
        "https://github.com/Relf-cc/Kern-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
